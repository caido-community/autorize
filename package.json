{
  "name": "autorize",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --fix packages/*/src",
    "knip": "knip",
    "test": "pnpm --filter backend test",
    "build": "caido-dev build",
    "build:shared": "pnpm --filter @caido-community/autorize run build",
    "watch": "caido-dev watch",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run test"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.6",
    "@caido/eslint-config": "0.8.0",
    "@caido/tailwindcss": "0.0.1",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "knip": "5.73.4",
    "postcss-prefixwrap": "1.57.2",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "overrides": {
      "@caido/sdk-shared": "0.2.2"
    }
  }
}
